        {"when": {"initial": "c", "final": "i"}, "then": {"initial": "tṣh"}},
        {"when": {"initial": "s", "final": "i"}, "then": {"initial": "ṣ"}},
        {"_comment": "Labialisation : g + et/ut -> kwet/kwut", "when": {"initial": "g", "final": "et"}, "then": {"final": "wet"}},
        {"when": {"initial": "g", "final": "ut"}, "then": {"final": "wut"}},
        {"_comment": "Palatalisation : ng devant i -> ny", "when": {"initial": "ng", "final_startswith": "i"}, "then": {"initial": "ny"}}
      ],
